{
  "manifest_version": 3,
  "name": "X-ID Converter",
  "short_name": "X-ID Conv",
  "version": "2.2.0",
  "minimum_chrome_version": "116",
  "description": "Converts base-36 X-IDs to integer IDs and back, from a popup or a right-click on selected text.",
  "author": {
    "email": "manu@caketuzz.com"
  },
  "homepage_url": "https://github.com/caketuzz/xid-converter",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "offscreen",
    "scripting",
    "clipboardWrite",
    "storage"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "X-ID ↔ integer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
